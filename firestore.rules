rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public readable content
    match /services/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /products/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /recipes/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /faq/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /site_content/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /availability/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Appointments can be created by any client, managed by admin
    match /appointments/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Atomic locks for slots to prevent double-booking
    match /booked_slots/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
